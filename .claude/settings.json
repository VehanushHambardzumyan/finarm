{
  "permissions": {
    "allow": [
      "Bash(node -e \":*)",
      "Bash(cmd /c \"netstat -aon -p tcp | findstr 3000\")",
      "Bash(cmd /c \"powershell -Command \"\"Get-Process -Name node -ErrorAction SilentlyContinue | Stop-Process -Force\"\"\")",
      "Bash(cmd /c \"powershell -Command \"\"Get-NetTCPConnection -LocalPort 3000 -ErrorAction SilentlyContinue | Select-Object LocalAddress,LocalPort,OwningProcess\"\"\")",
      "Bash(cmd /c \"powershell -Command \"\"Get-NetTCPConnection -LocalPort 3000 2>&1\"\"\")",
      "Bash(cmd /c \"netsh interface ipv4 show excludedportrange protocol=tcp\")",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:3001/health)",
      "Bash(curl -s -X POST http://localhost:3001/auth/login -H \"Content-Type: application/json\" -d '{\"\"identifier\"\":\"\"angelikapogh3596@gmail.com\"\",\"\"password\"\":\"\"test123\"\"}' -w \"\\\\nHTTP_STATUS:%{http_code}\")",
      "Bash(curl -s -X POST http://localhost:3001/auth/login -H \"Content-Type: application/json\" -H \"Origin: http://localhost:5173\" -d '{\"\"\"\"identifier\"\"\"\":\"\"\"\"angelikapogh3596@gmail.com\"\"\"\",\"\"\"\"password\"\"\"\":\"\"\"\"test123\"\"\"\"}' -v)",
      "Bash(curl -s -X POST http://localhost:3001/auth/login -H \"Content-Type: application/json\" -d '{\"\"identifier\"\":\"\"angelikapogh3596@gmail.com\"\",\"\"password\"\":\"\"wrongpass\"\"}' -w \"\\\\nHTTP:%{http_code}\")",
      "Bash(curl -s -X POST http://localhost:3001/auth/login -H \"Content-Type: application/json\" -H \"Origin: http://localhost:5173\" -d '{\"\"identifier\"\":\"\"angelikapogh3596@gmail.com\"\",\"\"password\"\":\"\"test123\"\"}' -w \"\\\\nHTTP:%{http_code}\")",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://[::1]:3001/health)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://127.0.0.1:3001/health)",
      "Bash(curl -sv http://127.0.0.1:3001/health)",
      "Bash(curl -s -X POST \"http://[::1]:5173/api/auth/login\" -H \"Content-Type: application/json\" -d '{\"\"identifier\"\":\"\"test@test.com\"\",\"\"password\"\":\"\"x\"\"}' -w \"\\\\nHTTP:%{http_code}\")",
      "Bash(npm run:*)",
      "Read(//c/Users/User/Desktop/**)",
      "Bash(powershell -Command \":*)"
    ]
  }
